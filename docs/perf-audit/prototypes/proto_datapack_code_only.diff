+    rg = staticRg[itemId]
+    if rg == nil then
+        rg = ANx.StaticReagents(itemId) or false
+        if staticRgN >= STATIC_RG_MAX then staticRg = {}; staticRgN = 0 end
+        staticRg[itemId] = rg
+        staticRgN = staticRgN + 1
+    end
+    return rg or nil
 end
 
