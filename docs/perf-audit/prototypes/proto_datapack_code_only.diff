+-- Static reagent list of a crafted item (Data_Reagents): ReagentsPacked is a
+-- sorted index of 4 hex craftedId + 5 hex 1-based position into ReagentBlob
+-- + 1 hex reagent count; the blob holds 6-char records of 4 hex reagentId +
+-- 2 hex count. Returns a NEW { rid1, n1, rid2, n2, ... } array or nil when the
+-- item is not craftable; Engine.ReagentsOf memoizes it. The old [id]={...}
+-- hash kept 2,847 subtables resident (~380 KB on the 32-bit client) for a
+-- report-time read.
+function ANx.StaticReagents(itemId)
+    local idx = ANx.ReagentsPacked
+    local v = idx and itemId and ANx.PackedFind(idx, itemId, 6)
+    if not v then return nil end
+    local n = v % 16
+    local p = (v - n) / 16
+    local blob, out = ANx.ReagentBlob, {}
+    for i = 1, n do
+        local c1, c2, c3, c4, c5, c6 = strbyte(blob, p, p + 5)
+        out[2 * i - 1] = HEXV[c1] * 4096 + HEXV[c2] * 256 + HEXV[c3] * 16 + HEXV[c4]
+        out[2 * i] = HEXV[c5] * 16 + HEXV[c6]
+        p = p + 6
+    end
+    return out
+end
+
