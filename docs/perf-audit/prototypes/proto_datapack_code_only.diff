+-- true when a giver location is known for the quest (= a waypoint arrow can
+-- be set); one packed probe, no decode.
+function ANx.HasQuestGiver(qid)
+    if not qid then return false end
+    local idx = ANx.QuestGiversPacked
+    if idx and ANx.PackedFind(idx, qid, 5) then return true end
+    local x = ANx.QuestGiversExtra
+    return (x and x[qid]) ~= nil
+end
