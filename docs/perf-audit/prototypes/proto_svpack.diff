+-- strings: every id list is comma-joined and every zone is ONE string.
+-- The summary sets are decoded at import (every count needs them); zones
+-- and instance lists are decoded lazily, on first access, so a cached
+-- login decodes nothing it does not show.
+local SC_FMT = 2
